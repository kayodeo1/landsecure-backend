# LandSecure API — environment
# Copy to .env for local dev. On Render these are set by render.yaml / the dashboard.

# Database. SQLite (default) needs no value. For Postgres use the full URL —
# a bare postgres:// or postgresql:// scheme is auto-upgraded to psycopg v3.
DATABASE_URL=sqlite:///./data/landsecure.db
# DATABASE_URL=postgresql://user:pass@host:5432/landsecure

# Auth — set a long random value in production.
JWT_SECRET=change-me-in-production-please-32chars
ACCESS_TOKEN_TTL_MIN=720
REFRESH_TOKEN_TTL_DAYS=7

# CORS. Comma-separated exact origins, plus an optional regex for dynamic ones.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Demo accounts created by the seeder on first boot.
SEED_ADMIN_EMAIL=admin@landsecure.ng
SEED_ADMIN_PASSWORD=admin1234
SEED_BUYER_EMAIL=buyer@landsecure.ng
SEED_BUYER_PASSWORD=buyer1234
